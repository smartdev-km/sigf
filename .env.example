SECRET_KEY=changez-moi
DATABASE_URL=sqlite:///sigf.db

# Stockage des scans. En local : laissez vide (fichiers dans instance/uploads).
# Sur Render : obligatoire (le disque de Render est effacé à chaque déploiement).
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# QR codes : QR_SECRET signe les documents (ne jamais le changer une fois des documents imprimés).
QR_SECRET=
PUBLIC_BASE_URL=http://127.0.0.1:5000

# Satellite Google (facultatif) : sans clé, la carte utilise Esri.
# Créez la clé dans Google Cloud (API « Maps JavaScript »), RESTREIGNEZ-LA aux adresses de votre site, ne la partagez pas.
GOOGLE_MAPS_API_KEY=
